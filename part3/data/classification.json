  "rules": {
    "components": {
      "packages": {
        "label": "Package installation",
        "regex": "\\bbun\\s+(?:install|add|remove|update|pm|publish|link|unlink|outdated|patch)\\b|\\b(?:lockfile|bun\\.lockb?|package manager|workspaces?|peer dependenc\\w*|npm (?:install|registry)|registry auth)\\b"
      },
      "build": {
        "label": "Build and code conversion",
        "regex": "\\bbun\\s+build\\b|\\b(?:bundl\\w*|transpil\\w*|sourcemaps?|source maps?|minif\\w*|tree.shak\\w*|standalone executable|single.file executable|--compile)\\b"
      },
      "test": {
        "label": "Tests",
        "regex": "\\bbun(?:\\s+|:)test\\b|\\b(?:test runner|mock\\w*|jest|toEqual|toMatchObject|toThrow|expect\\()"
      },
      "network": {
        "label": "HTTP and networks",
        "regex": "\\b(?:fetch|https?|http2|websockets?|TLS|SSL|DNS|TCP|UDP|proxy|Bun\\.serve|Bun\\.connect|Bun\\.listen)\\b|node:(?:http2?|https|tls|net|dns)"
      },
      "database": {
        "label": "SQL and storage",
        "regex": "\\b(?:SQL|SQLite|MySQL|PostgreSQL|postgres|mariadb|redis|Bun\\.SQL|Bun\\.sqlite)\\b|bun:sqlite"
      },
      "process": {
        "label": "Processes and shell",
        "regex": "\\b(?:Bun\\.spawn|Bun\\.Shell|child_process|spawnSync|subprocess\\w*|shell|SIGCHLD|process\\.env|process\\.exit|stdin|stdout|stderr)\\b|\\bbun run\\b"
      },
      "filesystem": {
        "label": "Files and file watching",
        "regex": "\\b(?:node:fs|fs\\.\\w+|Bun\\.file|Bun\\.write|readFile\\w*|writeFile\\w*|watch\\w*|file system|filesystem|symlink\\w*|readdir|fallocate)\\b"
      },
      "modules": {
        "label": "Modules and compatibility",
        "regex": "\\b(?:node:module|CommonJS|CJS|ESM|require\\(|import\\s|module resol\\w*|node(?:\\.js)? compat\\w*)"
      },
      "native": {
        "label": "Native code and FFI",
        "regex": "\\b(?:FFI|NAPI|N-API|node.api|native addon\\w*|JavaScriptCore|JSC|WebAssembly|WASM)\\b"
      },
      "types": {
        "label": "TypeScript types",
        "regex": "\\b(?:TypeScript|bun-types|typecheck\\w*|type check\\w*|type definitions?|\\.d\\.ts)\\b"
      }
    },
    "symptoms": {
      "crash": {
        "label": "Crash or fatal signal",
        "regex": "\\b(?:crash\\w*|segfault\\w*|SIGSEGV|SIGABRT|SIGILL|segmentation fault|access violation|illegal instruction|bus error)\\b"
      },
      "panic": {
        "label": "Panic or failed check",
        "regex": "\\b(?:panic\\w*|assertion fail\\w*|assert\\w* failed|unreachable)\\b"
      },
      "hang": {
        "label": "Hang or deadlock",
        "regex": "\\b(?:hang(?:s|ing)?|hung|deadlock\\w*|freez\\w*|frozen|infinite loop|stuck|never (?:exit\\w*|finish\\w*|resolv\\w*))\\b"
      },
      "memory": {
        "label": "Memory problems",
        "regex": "\\b(?:memory leak\\w*|memory usage|memory consumption|out.of.memory|OOM|heap corruption|use.after.free|double.free|buffer overflow)\\b"
      },
      "performance": {
        "label": "Performance",
        "regex": "\\b(?:slow\\w*|performance|CPU (?:usage|spike)|high CPU|100% CPU|latency|throughput)\\b"
      },
      "correctness": {
        "label": "Wrong or missing result",
        "regex": "\\b(?:incorrect\\w*|wrong|corrupt\\w*|truncat\\w*|mismatch\\w*|missing|ignored|ignores|silently|unexpected\\w*|misread\\w*|drops?|deletes?|pads?)\\b"
      },
      "failure": {
        "label": "Reported error",
        "regex": "\\b(?:fails?|failure|cannot|can't|unable|does(?:n.t| not) work|not working|error)\\b"
      }
    }
  }
}
